# syntax=docker/dockerfile:1.7
# FRISKYDINGO worker (Illustrious/NoobAI base) WITH FaceDetailer. Same graph family as kodorail
# (genphoto applies clip-skip 2 for illustrious). Refiner + detailer identical to illustrious.
FROM runpod/worker-comfyui:5.8.6-base
ARG CIVITAI_TOKEN
RUN --mount=type=secret,id=civitai \
    CIVITAI_API_TOKEN="$(cat /run/secrets/civitai)" \
    comfy model download --url "https://civitai.com/api/download/models/3092240" \
      --relative-path models/checkpoints --filename friskydingo.safetensors
RUN comfy model download \
      --url "https://huggingface.co/RunDiffusion/Juggernaut-XL-v9/resolve/main/Juggernaut-XL_v9_RunDiffusionPhoto_v2.safetensors" \
      --relative-path models/checkpoints --filename juggernaut.safetensors
RUN comfy model download \
      --url "https://huggingface.co/Bingsu/adetailer/resolve/main/face_yolov8m.pt" \
      --relative-path models/ultralytics/bbox --filename face_yolov8m.pt
# Hand detector for --hand-detail (body-part detailers, #12). Same HF source + bbox dir as the
# face detector; genphoto chains an FD_hand FaceDetailer node after the face pass.
RUN comfy model download \
      --url "https://huggingface.co/Bingsu/adetailer/resolve/main/hand_yolov8s.pt" \
      --relative-path models/ultralytics/bbox --filename hand_yolov8s.pt
RUN comfy model download --url "https://github.com/zg-claude/muse-comfy-worker/releases/download/loras-v1/roxy_illust.safetensors" \
      --relative-path models/loras --filename roxy_illust.safetensors
RUN --mount=type=secret,id=civitai \
    CIVITAI_API_TOKEN="$(cat /run/secrets/civitai)" \
    comfy model download --url "https://civitai.com/api/download/models/3074764" \
      --relative-path models/loras --filename uvg5.safetensors
RUN comfy-node-install comfyui-impact-pack comfyui-impact-subpack
RUN for r in /comfyui/custom_nodes/*/requirements.txt; do pip install --no-cache-dir -r "$r" || true; done && \
    pip install --no-cache-dir opencv-python-headless "numpy<2"
