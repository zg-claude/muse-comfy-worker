# syntax=docker/dockerfile:1.7
# KODORAIL + DETECTORS (Fable, Jul 25). FROM the exact digest the working muse-kodorail endpoint
# runs - the MOST proven image of the day (watched it complete a real gen this afternoon). Adds
# ONLY the 3 detector files; zero dependency changes.
FROM ghcr.io/zg-claude/muse-comfy-worker@sha256:63c771865d03611dd61fa788830fb9e039df81328f44329e494237730350fb1d

RUN comfy model download --url "https://huggingface.co/Bingsu/adetailer/resolve/main/hand_yolov8s.pt" \
      --relative-path models/ultralytics/bbox --filename hand_yolov8s.pt
RUN comfy model download --url "https://huggingface.co/NSFW-API/NSFW_Segmentation/resolve/main/nsfw-seg-vagina-x.pt" \
      --relative-path models/ultralytics/segm --filename nsfw-seg-vagina-x.pt
RUN comfy model download --url "https://huggingface.co/NSFW-API/NSFW_Segmentation/resolve/main/nsfw-seg-breast-x.pt" \
      --relative-path models/ultralytics/segm --filename nsfw-seg-breast-x.pt
