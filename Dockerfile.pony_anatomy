# syntax=docker/dockerfile:1.7
# LEAN ANATOMY, region-free (Jul 25 2026). Slim+volume is blocked on RunPod (driver/DC-pin wall,
# see the docker guide). So: bake a region-free image like the working ones, but ADD hand + anatomy
# detectors, and DROP sam2 - the ~10GB hog impact-subpack pulls that made friskydingo (~30GB) too fat
# to boot. The YOLO segm anatomy detectors run via UltralyticsDetectorProvider and do NOT need sam2.
# Target ~22GB, like the kodorail image that boots fine. cyberrealistic_pony = Zach's main model.
FROM runpod/worker-comfyui:5.8.6-base

# --- checkpoint + skin refiner + LoRAs (baked; region-free) ---
RUN --mount=type=secret,id=civitai CIVITAI_API_TOKEN="$(cat /run/secrets/civitai)" \
    comfy model download --url "https://civitai.com/api/download/models/2884631" \
      --relative-path models/checkpoints --filename cyberrealistic_pony.safetensors
RUN comfy model download \
      --url "https://huggingface.co/RunDiffusion/Juggernaut-XL-v9/resolve/main/Juggernaut-XL_v9_RunDiffusionPhoto_v2.safetensors" \
      --relative-path models/checkpoints --filename juggernaut.safetensors
RUN comfy model download --url "https://github.com/zg-claude/muse-comfy-worker/releases/download/loras-v1/roxy_pony.safetensors" \
      --relative-path models/loras --filename roxy_pony.safetensors
RUN --mount=type=secret,id=civitai CIVITAI_API_TOKEN="$(cat /run/secrets/civitai)" \
    comfy model download --url "https://civitai.com/api/download/models/3074764" \
      --relative-path models/loras --filename uvg5.safetensors

# --- detectors: face + hand (bbox) + anatomy (segm). Small. ---
RUN comfy model download --url "https://huggingface.co/Bingsu/adetailer/resolve/main/face_yolov8m.pt" \
      --relative-path models/ultralytics/bbox --filename face_yolov8m.pt
RUN comfy model download --url "https://huggingface.co/Bingsu/adetailer/resolve/main/hand_yolov8s.pt" \
      --relative-path models/ultralytics/bbox --filename hand_yolov8s.pt
RUN comfy model download --url "https://huggingface.co/NSFW-API/NSFW_Segmentation/resolve/main/nsfw-seg-vagina-x.pt" \
      --relative-path models/ultralytics/segm --filename nsfw-seg-vagina-x.pt
RUN comfy model download --url "https://huggingface.co/NSFW-API/NSFW_Segmentation/resolve/main/nsfw-seg-breast-x.pt" \
      --relative-path models/ultralytics/segm --filename nsfw-seg-breast-x.pt

# --- detailer nodes: FULL install (dropping sam2 broke impact-pack's import -> FaceDetailer
# node never registered -> all detailers failed. sam2 stays; it only saved 3GB and 30GB images
# boot fine region-free, so leanness was not worth a broken detailer chain). numpy<2 pinned LAST.
RUN comfy-node-install comfyui-impact-pack comfyui-impact-subpack
RUN for r in /comfyui/custom_nodes/*/requirements.txt; do pip install --no-cache-dir -r "$r" || true; done && \
    pip install --no-cache-dir opencv-python-headless "numpy<2"
