# syntax=docker/dockerfile:1.7
# KREA2 baked worker = the PROVEN chroma image + the krea2 UNet + a Flux.1-D LoRA. Nothing else:
# no pip installs, no S3, no multi-stage. Same shape as the chroma Dockerfile that works.
#
# ROOT CAUSE of ~6 failed builds (Jul 27): civitai's /api/download/models/<id> takes a VERSION id,
# not a MODEL id. I used the model id 2734469 -> 404. That 404 sent me to our RunPod volume, which
# needed boto3, which needed S3 secrets, which broke on presigned URLs, then on missing curl, then
# a pip install into the runtime image that made the worker exit 1. One wrong number.
#   model   2734469 = "Krea2_Center_SemiRaw"
#   version 3075365 = "v1.0 fp8"   <- the correct download id
FROM ghcr.io/zg-claude/muse-comfy-worker@sha256:bbd91256983f069515245f51e94e009519e42376160c27c73fb001412f014813
RUN --mount=type=secret,id=civitai CIVITAI_API_TOKEN="$(cat /run/secrets/civitai)" \
    comfy model download --url "https://civitai.com/api/download/models/3075365" \
      --relative-path models/unet --filename krea2_center_semiraw.safetensors
# Flux.1-D LoRA (Ashlynn, civitai version 1661696) - tests whether Flux.1-dev LoRAs load on Krea.
RUN --mount=type=secret,id=civitai CIVITAI_API_TOKEN="$(cat /run/secrets/civitai)" \
    comfy model download --url "https://civitai.com/api/download/models/1661696" \
      --relative-path models/loras --filename ashlynn_flux.safetensors
