# syntax=docker/dockerfile:1.7
# KREA2 baked worker = the PROVEN chroma image + the OFFICIAL Krea 2 Turbo UNet + a Flux.1-D LoRA.
# No pip installs, no S3, no multi-stage - same shape as the chroma Dockerfile that works.
#
# MODEL CHOICE (Zach, Jul 27: "i dont want some weird thing thats half baked. Never asked for it"):
# use the OFFICIAL Comfy-Org Krea 2 Turbo checkpoint, NOT the community "Krea2_Center_SemiRaw"
# variant that an earlier session picked with no recorded rationale. Krea exists to answer "does the
# Flux.1-dev LoRA ecosystem work for us" - a niche community merge adds an unknown to that test.
#   model   2726029 = "Krea 2 Turbo Official Comfy-Org Checkpoints"
#   version 3064297 = "krea2_turbo_fp8"   <- the correct DOWNLOAD id (civitai wants a VERSION id;
#                                            using a MODEL id 404s - that mistake caused ~6 failed
#                                            builds and every S3/boto3 workaround since.)
FROM ghcr.io/zg-claude/muse-comfy-worker@sha256:bbd91256983f069515245f51e94e009519e42376160c27c73fb001412f014813
RUN --mount=type=secret,id=civitai CIVITAI_API_TOKEN="$(cat /run/secrets/civitai)" \
    comfy model download --url "https://civitai.com/api/download/models/3064297" \
      --relative-path models/unet --filename krea2_turbo.safetensors
# Flux.1-D LoRA (Ashlynn, civitai version 1661696) - tests whether Flux.1-dev LoRAs load on Krea.
RUN --mount=type=secret,id=civitai CIVITAI_API_TOKEN="$(cat /run/secrets/civitai)" \
    comfy model download --url "https://civitai.com/api/download/models/1661696" \
      --relative-path models/loras --filename ashlynn_flux.safetensors
