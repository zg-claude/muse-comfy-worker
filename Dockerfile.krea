# syntax=docker/dockerfile:1.7
# KREA2 baked worker (Flux-family/T5, TURBO). BAKED region-free per atlas/docs/muse-infra.md.
# krea2 UNet pulled by python urllib from a presigned S3 URL of our own volume - the base image has
# NO curl (exit 127) and comfy model download 401s on S3 URLs. URL is temporary; model is baked in.
FROM runpod/worker-comfyui:5.8.6-base
RUN python3 <<'PYEOF'
import urllib.request, os
os.makedirs("/comfyui/models/unet", exist_ok=True)
print("downloading krea2_center_semiraw (8GB)...", flush=True)
urllib.request.urlretrieve("https://s3api-us-il-1.runpod.io/hf1f5zarw3/ComfyUI/models/diffusion_models/krea2_center_semiraw.safetensors?X-Amz-Algorithm=AWS4-HMAC-SHA256&X-Amz-Credential=user_3GiwbPjhOyCJI0MQNcnjUUwEjWB%2F20260727%2FUS-IL-1%2Fs3%2Faws4_request&X-Amz-Date=20260727T112503Z&X-Amz-Expires=14400&X-Amz-SignedHeaders=host&X-Amz-Signature=ace1d019288dec9fc5d695e5b188ec4058e217ddf8cfc4529de996d226989254", "/comfyui/models/unet/krea2_center_semiraw.safetensors")
print("krea2 download complete", flush=True)
PYEOF
RUN comfy model download \
      --url "https://huggingface.co/comfyanonymous/flux_text_encoders/resolve/main/t5xxl_fp16.safetensors" \
      --relative-path models/text_encoders --filename t5xxl_fp16.safetensors
RUN comfy model download \
      --url "https://huggingface.co/sirorable/flux-ae-vae/resolve/main/ae.safetensors" \
      --relative-path models/vae --filename ae.safetensors
