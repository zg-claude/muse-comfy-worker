# syntax=docker/dockerfile:1.7
# KREA2 baked worker (Flux.1-Krea family, TURBO). BAKED region-free per atlas/docs/muse-infra.md.
# krea2 UNet pulled with boto3 (SigV4 HEADER auth) from our RunPod volume - RunPod S3 rejects
# query-string presigned URLs (403); comfy-download and curl also failed. Creds via build secrets
# (no layer leak). Model is baked in; secrets never persist.
FROM runpod/worker-comfyui:5.8.6-base
RUN pip install --no-cache-dir boto3
RUN --mount=type=secret,id=s3key --mount=type=secret,id=s3secret python3 <<'PYEOF'
import boto3, os
os.makedirs("/comfyui/models/unet", exist_ok=True)
s3 = boto3.client("s3", endpoint_url="https://s3api-us-il-1.runpod.io",
    aws_access_key_id=open("/run/secrets/s3key").read().strip(),
    aws_secret_access_key=open("/run/secrets/s3secret").read().strip(),
    region_name="US-IL-1")
print("downloading krea2_center_semiraw (8GB) via boto3...", flush=True)
s3.download_file("hf1f5zarw3", "ComfyUI/models/diffusion_models/krea2_center_semiraw.safetensors",
                 "/comfyui/models/unet/krea2_center_semiraw.safetensors")
print("krea2 download complete", flush=True)
PYEOF
RUN comfy model download \
      --url "https://huggingface.co/comfyanonymous/flux_text_encoders/resolve/main/t5xxl_fp16.safetensors" \
      --relative-path models/text_encoders --filename t5xxl_fp16.safetensors
RUN comfy model download \
      --url "https://huggingface.co/sirorable/flux-ae-vae/resolve/main/ae.safetensors" \
      --relative-path models/vae --filename ae.safetensors

# Flux.1-D LoRA (Ashlynn, civitai 1661696) - proves whether Flux.1-dev LoRAs load on Krea.
RUN --mount=type=secret,id=civitai CIVITAI_API_TOKEN="$(cat /run/secrets/civitai)" \
    comfy model download --url "https://civitai.com/api/download/models/1661696" \
      --relative-path models/loras --filename ashlynn_flux.safetensors
